  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "harper.js": "3.0.0",
    "html-validate": "^11.21.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0"
  }
}
